.List_Selected_Off {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgba(255, 144, 0, 255);
    transition-timing-function: ease-out;
    transition-duration: 0.2s;
    scale: 0 1;
}

.List_Selected_On {
    width: 100%;
    flex-grow: 1;
    background-color: rgba(255, 144, 0, 255);
    height: 100%;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

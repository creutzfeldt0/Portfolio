VisualElement {
}

.BTN_Base {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 169, 0);
    border-right-color: rgb(255, 169, 0);
    border-top-color: rgb(255, 169, 0);
    border-bottom-color: rgb(255, 169, 0);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-font: resource('Font/NotoSansKR-Regular');
    -unity-text-align: middle-center;
}

.BTN_Base:hover {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 169, 0);
    border-right-color: rgb(255, 169, 0);
    border-top-color: rgb(255, 169, 0);
    border-bottom-color: rgb(255, 169, 0);
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    -unity-text-align: middle-center;
    -unity-font: resource('Font/NotoSansKR-Regular');
}

.BTN_Selected_Off {
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgb(255, 169, 0);
    flex-shrink: 1;
    flex-grow: 1;
    transform-origin: left;
    scale: 0 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.BTN_Selected_On {
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgb(255, 169, 0);
    flex-shrink: 1;
    flex-grow: 1;
    transform-origin: left;
    scale: 1 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.LB_BTN_Text {
    position: absolute;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    color: rgb(255, 255, 255);
    -unity-font: resource('Font/NotoSansKR-Regular');
    -unity-text-align: middle-center;
}

.LB_BTN_Text_Hover {
    transition-duration: 0.2s;
    position: absolute;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-font: resource('Font/NotoSansKR-Regular');
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
}
